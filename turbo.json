{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.schema"],
  "globalEnv": [
    "APP_ENV",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CANARY_MCP_URL",
    "CI",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "DB_HOST",
    "DB_PASSWORD",
    "DB_PORT",
    "DB_USERNAME",
    "DO_NOT_TRACK",
    "ELECTRIC_SECRET",
    "ELECTRIC_URL",
    "GITHUB_ACTIONS",
    "NETLIFY",
    "OPENROUTER_API_KEY",
    "RUN_FLUSH_BATCH",
    "RUN_FLUSH_INTERVAL",
    "RUN_RECOVERY_INTERVAL",
    "RUN_STALE_TTL",
    "VARLOCK_TELEMETRY_DISABLED",
    "VERCEL",
    "VERCEL_ENV",
    "VITE_SERVER_URL",
    "WORKERS_CI_BRANCH"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
