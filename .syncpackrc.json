{
  "$schema": "./node_modules/syncpack/schema.json",
  "versionGroups": [
    {
      "label": "Local packages use workspace:*",
      "dependencies": ["$LOCAL"],
      "dependencyTypes": ["dev", "prod"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "The legacy TUI stays on Effect 3",
      "packages": ["tui"],
      "dependencies": ["effect"],
      "isIgnored": true
    }
  ]
}
