# Shared environment contract. Runnable packages import this file.
#
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# PostgreSQL

DB_HOST=localhost

DB_USERNAME=postgres

# @type=number
DB_PORT=5432

# @required @sensitive @type=string(minLength=1)
DB_PASSWORD=

# @required @sensitive @type=url
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/canary

# Better Auth

# @required @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @required @type=url
BETTER_AUTH_URL=http://localhost:3001

# @optional @type=url
CANARY_MCP_URL=

# @required @type=url
CORS_ORIGIN=${BETTER_AUTH_URL}

# Electric

# @optional @sensitive
ELECTRIC_SECRET=

# @required @type=url @dynamic
ELECTRIC_URL=http://localhost:3002

# Agents

AGENT_MODEL=~moonshotai/kimi-latest

# @optional @sensitive
OPENROUTER_API_KEY=

# Runner

# @type=number
RUN_FLUSH_BATCH=32

# Varlock normalizes these durations to milliseconds before Effect reads them.
# @type=duration
RUN_FLUSH_INTERVAL=60ms

# @type=duration
RUN_RECOVERY_INTERVAL=30s

# @type=duration
RUN_STALE_TTL=10m
