{
  "name": "canary",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:tui": "turbo run dev --filter=tui",
    "dev:web": "turbo run dev --filter=web",
    "db:generate": "turbo run db:generate --filter=@canary/db",
    "db:migrate": "turbo run db:migrate --filter=@canary/db",
    "db:push": "turbo run db:push --filter=@canary/db",
    "db:studio": "turbo run db:studio --filter=@canary/db",
    "check": "oxlint && oxfmt --write",
    "prepare": "husky && effect-language-service patch"
  },
  "dependencies": {
    "@canary/env": "workspace:*",
    "@effect/cli": "^0.75.1",
    "@effect/platform": "^0.96.1",
    "@effect/platform-bun": "^0.89.0",
    "dotenv": "^17.4.2",
    "effect": "^3.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@canary/config": "workspace:*",
    "@effect/language-service": "^0.86.2",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "portless": "^0.14.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "mise exec -- bunx oxlint"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml}": [
      "mise exec -- bunx oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.toml": [
      "mise exec -- taplo format"
    ]
  },
  "packageManager": "bun@1.3.14"
}
